@page "/"
@rendermode InteractiveServer
@using JetX.Domain.Entities
@using JetX.Application.Interfaces
@inject IJetRepository JetRepository
@inject IRouteRepository RouteRepository

<PageTitle>JetX | Centro de Mando Operativo</PageTitle>

<div class="container-fluid p-0">
    <!-- Título y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-white">Centro de Mando Operativo</h3>
            <p class="text-white-50 mb-0 small">Disponibilidad de flota ejecutiva, red de aerovías y estado de reservas</p>
        </div>
        <button class="btn btn-sm px-3 py-2 text-white"
                style="background-color: #182030; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;"
                @onclick="CargarMetricasAsync">
            <i class="bi bi-arrow-clockwise me-1 text-info"></i> Actualizar
        </button>
    </div>

    @if (cargando)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-info" role="status"></div>
            <span class="ms-3 text-white-50">Sincronizando con Supabase...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger shadow-sm border-0" style="background-color: rgba(239, 68, 68, 0.15); color: #fca5a5;">
            <strong>Error:</strong> @error
        </div>
    }
    else
    {
        <!-- KPI Cards con Estilo HelpDesk -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="p-3 rounded-3" style="background-color: #141824; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 11px;">Flota Total</span>
                        <div class="rounded-2 p-2" style="background-color: rgba(0, 210, 255, 0.1); color: #00d2ff;">
                            <i class="bi bi-airplane-engines fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-white mb-0">@totalJets</h2>
                    <small class="text-success" style="font-size: 11px;"><i class="bi bi-arrow-up-right me-1"></i>Aeronaves registradas</small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="p-3 rounded-3" style="background-color: #141824; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 11px;">Disponibles</span>
                        <div class="rounded-2 p-2" style="background-color: rgba(34, 197, 94, 0.1); color: #22c55e;">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0" style="color: #22c55e;">@jetsDisponibles</h2>
                    <small class="text-white-50" style="font-size: 11px;">Listas para despacho inmediato</small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="p-3 rounded-3" style="background-color: #141824; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 11px;">Mantenimiento</span>
                        <div class="rounded-2 p-2" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                            <i class="bi bi-tools fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0" style="color: #f59e0b;">@(totalJets - jetsDisponibles)</h2>
                    <small class="text-white-50" style="font-size: 11px;">En inspección técnica de hangar</small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="p-3 rounded-3" style="background-color: #141824; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 11px;">Red de Aerovías</span>
                        <div class="rounded-2 p-2" style="background-color: rgba(168, 85, 247, 0.1); color: #c084fc;">
                            <i class="bi bi-diagram-3-fill fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0" style="color: #c084fc;">@totalAerovias</h2>
                    <small class="text-white-50" style="font-size: 11px;">Tramos del grafo PostGIS</small>
                </div>
            </div>
        </div>

        <!-- Tabla y Tarjeta de Accesos Directos -->
        <div class="row g-3">
            <div class="col-12 col-lg-8">
                <div class="p-4 rounded-3" style="background-color: #141824; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-white">Flota Activa en Servicio</h6>
                        <a href="jets" class="small text-decoration-none" style="color: #00d2ff;">Ver todos &rarr;</a>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0" style="color: #cbd5e1;">
                            <thead>
                                <tr class="text-white-50 border-bottom" style="border-color: rgba(255,255,255,0.06) !important; font-size: 12px;">
                                    <th>MATRÍCULA</th>
                                    <th>MODELO</th>
                                    <th>CAPACIDAD</th>
                                    <th>TARIFA USD</th>
                                    <th>ESTADO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ultimosJets != null)
                                {
                                    @foreach (var jet in ultimosJets)
                                    {
                                        <tr class="border-bottom" style="border-color: rgba(255,255,255,0.03) !important;">
                                            <td class="fw-bold text-white">@jet.Matricula</td>
                                            <td class="text-white-50">@jet.Modelo</td>
                                            <td>@jet.CapacidadPasajeros pax</td>
                                            <td class="fw-semibold text-white">$@jet.CostoHoraUsd.ToString("N2")/h</td>
                                            <td>
                                                @if (jet.Estado == "Disponible")
                                                {
                                                    <span class="badge px-3 py-1 rounded-pill"
                                                          style="background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3);">
                                                        Disponible
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge px-3 py-1 rounded-pill"
                                                          style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                                                        @jet.Estado
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Accesos a Módulos del Sistema -->
            <div class="col-12 col-lg-4">
                <div class="p-4 rounded-3 d-flex flex-column gap-3" style="background-color: #141824; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <h6 class="fw-bold mb-1 text-white">Accesos Directos</h6>
                    
                    <a href="radar" class="p-3 rounded-3 text-decoration-none d-flex align-items-center justify-content-between"
                           style="background-color: #1a2233; border: 1px solid rgba(0, 210, 255, 0.25);">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-globe-americas fs-4" style="color: #00d2ff;"></i>
                            <div>
                                <strong class="d-block text-white" style="font-size: 14px;">Radar 3D en Vivo</strong>
                                <small class="text-white-50" style="font-size: 12px;">Telemetría ADS-B & WorldWind</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-white-50"></i>
                    </a>

                    <a href="jets" class="p-3 rounded-3 text-decoration-none d-flex align-items-center justify-content-between"
                           style="background-color: #171c28; border: 1px solid rgba(255, 255, 255, 0.06);">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-airplane-engines fs-4 text-warning"></i>
                            <div>
                                <strong class="d-block text-white" style="font-size: 14px;">Gestión de Flota</strong>
                                <small class="text-white-50" style="font-size: 12px;">Tarifas, estados y hangares</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-white-50"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool cargando = true;
    private string? error;
    private int totalJets = 0;
    private int jetsDisponibles = 0;
    private int totalAerovias = 0;
    private IEnumerable<Jet>? ultimosJets;

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricasAsync();
    }

    private async Task CargarMetricasAsync()
    {
        cargando = true;
        error = null;

        try
        {
            var jetsTask = JetRepository.ObtenerTodosLosJetsAsync();
            var aeroviasTask = RouteRepository.ObtenerTodasLasAeroviasAsync();

            await Task.WhenAll(jetsTask, aeroviasTask);

            ultimosJets = await jetsTask;
            var aerovias = await aeroviasTask;

            totalJets = ultimosJets?.Count() ?? 0;
            jetsDisponibles = ultimosJets?.Count(j => j.Estado == "Disponible") ?? 0;
            totalAerovias = aerovias?.Count() ?? 0;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}